# LaTeX and presentation build intermediates
build/*
!build/.gitkeep
*.aux
*.bbl
*.blg
*.dvi
*.fdb_latexmk
*.fls
*.log
*.synctex.gz
*.nav
*.out
*.snm
*.toc

# Office lock files
~$*

# Local Python environment
.venv/

# Python bytecode and caches
__pycache__/
*.py[cod]

# Generated resource exports
exported/*
