@article{DeBlois1970,
  title = {Counting and Sizing of Submicron Particles by the Resistive Pulse Technique},
  author = {DeBlois, R. W. and Bean, C. P.},
  year = 1970,
  journal = {Review of Scientific Instruments},
  volume = {41},
  number = {7},
  pages = {909--916},
  issn = {00346748},
  doi = {10.1063/1.1684724},
  abstract = {The resistive (Coulter) method of counting and sizing particles in a conducting fluid has been extended to polystyrene spheres 900 \AA{} in diameter, with a present detection limit near 600 \AA, through the use of individual submicron pores etched in irradiated plastic sheet. The use of a nonionic surfactant and ultrasonic cleaning effectively relieves the problem of plugging. The particles may be driven through the pore by the electric field, without the use of pressure, to yield the vector sum of the electrophoretic and electro-osmotic velocities. A new theory, yielding an upper limit to the resistive pulse on passage of a sphere, agrees well with data for spheres with diameters d\textexclamdown 0.4D, where D is the pore diameter, and complements a previous theory that gives a lower limit, valid for d\textquestiondown 0.9D. We estimate that a detection limit near 250 \AA{} will be attainable with the further development of current techniques. \copyright{} 1970 The American Institute of Physics.}
}

