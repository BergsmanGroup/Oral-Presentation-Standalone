@article{Sokolov2006,
  title = {{{AFM}} Study of Forces between Silica, Silicon Nitride and Polyurethane Pads},
  author = {Sokolov, Igor and Ong, Quy K. and Shodiev, Hasan and Chechik, Nina and James, David and Oliver, Mike},
  year = 2006,
