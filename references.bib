@misc{reece2026,
  title = {High {{Throughput Screening}} of {{Alucone}} and {{Zincone Extreme Ultraviolet Photoresists}} through {{Molecular Layer Deposition}}},
  author = {Reece, Duncan J and Crum, Emily R and Keth, Jane and Bergsman, David S},
  year = 2026,
  month = mar,
  doi = {10.26434/chemrxiv.15000973/v1},
  urldate = {2026-08-05},
  abstract = {As extreme ultraviolet (EUV) lithography advances toward sub-10 nm half-pitch patterning, photoresists must deliver improved sensitivity while enabling higher resolution and reduced line-edge roughness. Hybrid organic-inorganic thin films deposited via molecular layer deposition (MLD) offer tunable composition and enhanced EUV absorptivity, making them promising resist candidates. Here, using a high-throughput MLD reactor, we screen twelve chemistries, comprising aluminum-and zinc-based hybrids linked by one of six organic diols, for their stability and processability. From these, an alkynefunctionalized alucone incorporating 2-butyne-1,4-diol (BTY) emerged as the leading candidate for detailed study. Characterization of this chemistry through Fourier-transform infrared spectroscopy, X-ray photoelectron spectroscopy, and time-of-flight secondary ion mass spectrometry confirmed alkyne incorporation within the hybrid network, where the electron-rich triple bond may serve as a preferential site for radiation-induced crosslinking. Using electron-beam lithography at 100 kV as a proxy for EUV resist evaluation, a sensitivity of {$D$} 50 = 2695 \textmu C cm -2 with high contrast, {$\gamma$} = 2.19, was achieved while requiring 300\texttimes{} more dilute developer than previously reported hafnium-based MLD resists. Compared to other aluminum-based MLD resists, BTY-alucone exhibited 21-33\texttimes{} higher sensitivity. Dense patterns at 20 nm half-pitch were also achieved. These results establish alkyne-functionalized alucone as a promising EUV resist candidate and validate high-throughput MLD screening for accelerated resist development.},
  langid = {english},
  file = {C:\Users\jmwerner\Zotero\storage\7BV42EPU\Reece et al. - 2026 - High Throughput Screening of Alucone and Zincone Extreme Ultraviolet Photoresists through Molecular.pdf}
}

