@article{Nakata2022,
  title = {Accelerated Deep Learning Dynamics for Atomic Layer Deposition of al(Me)3and Water on {{OH}}/Si(111)},
  author = {Nakata, Hiroya and Filatov(gulak), Michael and Choi, Cheol Ho},
