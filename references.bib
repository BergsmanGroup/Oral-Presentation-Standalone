@article{Luchansky2010,
  title = {Characterization of the Evanescent Field Profile and Bound Mass Sensitivity of a Label-Free Silicon Photonic Microring Resonator Biosensing Platform},
  author = {Luchansky, Matthew S. and Washburn, Adam L. and Martin, Teresa A. and Iqbal, Muzammil and Gunn, L. Cary and Bailey, Ryan C.},
  year = 2010,
  month = dec,
  journal = {Biosensors and Bioelectronics},
  volume = {26},
  number = {4},
  pages = {1283--1291},
  issn = {09565663},
  doi = {10.1016/j.bios.2010.07.010},
  abstract = {Silicon photonic microring resonators have emerged as a sensitive and highly multiplexed platform for real-time biomolecule detection. Herein, we profile the evanescent decay of device sensitivity towards molecular binding as a function of distance from the microring surface. By growing multilayers of electrostatically bound polymers extending from the sensor surface, we are able to empirically determine that the evanescent field intensity is characterized by a 1/e response decay distance of 63nm. We then applied this knowledge to study the growth of biomolecular assemblies consisting of alternating layers of biotinylated antibody and streptavidin, which follow a more complex growth pattern. Additionally, by monitoring the shift in microring resonance wavelength upon the deposition of a radioactively labeled protein, the mass sensitivity of the ring resonator platform was determined to be 14.7\textpm 6.7 [pg/mm2]/{$\Delta$}pm. By extrapolating to the instrument noise baseline, the mass/area limit of detection is found to be 1.5\textpm 0.7pg/mm2. Taking the small surface area of the microring sensor into consideration, this value corresponds to an absolute mass detection limit of 125ag (i.e. 0.8 zmol of IgG), demonstrating the remarkable sensitivity of this promising label-free biomolecular sensing platform. \copyright{} 2010 Elsevier B.V.},
  pmid = {20708399},
  keywords = {Biosensor,Evanescent field,Label-free,Microring resonator,Silicon photonics}
}

@techreport{Lucy1999,
  title = {998 {{W}}.{{A}}.{{E}}. {{McBryde}} Medal Lecture Searching for the Holy Grail in Analytical Separations 1},
  author = {Lucy, Charles A and Yeung, Ken K-C and Fu, Shilin and Li, Dongmei and Henselwood, Tracey L and Underhill, Royale S},
  year = 1999,
  abstract = {This paper describes the chemistry presented during the W.A.E. McBryde Medal address given at the 81st Chemistry in Canada Conference held in Whistler. The narrative chronicles our Quest to perform isotopic separations in the solution phase using as our Excalibur, capillary zone electrophoresis. The narrative takes you through the highs of our early success in separating 35 Cl-and 37 Cl-. This separation was achieved by adjusting the electroosmotic flow to be equal in magnitude but opposite in direction to the chloride mobility. The narrative then takes you through the dark days, when we could not extend the isotopic separations to cationic species or even explain why there was an isotopic effect on mobility. Since those dark days, we have made numerous discoveries that have aided our Quest. Firstly, the development of mixed surfactant wall coating procedures yielded control of the reversed electroosmotic flow. This control enabled us to perform isotopic separations of systems such as 15 N-14 N-aniline and 15 NH 4 + 14 NH 4 +. In terms of understanding electrophoretic mobility, we demonstrate the importance of dielectric friction to mobility. Further, the effect of ionic strength in capillary zone electrophoresis is explained using the Pitts treatment, which is analogous to the extended Debye-H\"uckel equation for ionic activity. So, have we completed our Quest? Read on. R\'esum\'e : Ce travail d\'ecrit la chimie d\'ecrite au cours de la conf\'erence W.A.E. McBryde pr\'esent\'ee lors de la 81\`eme Conf\'erence de chimie au Canada qui s'est tenue \`a Whistler. La narration fait la chronique des \'ev\'enements qui ont accompagn\'e notre qu\^ete en vue de r\'ealiser des s\'eparations isotopiques en solution en utilisant comme Excalibur l'\'electrophor\`ese en zone capillaire. Cette narration vous guide vers les sommets de nos succ\`es pr\'eliminaires dans la s\'eparation du 35 Cl-et du 37 Cl-. Cette s\'eparation a \'et\'e effectu\'ee en ajustant l'\'ecoulement \'electroosmotique de fa\c con \`a rendre son amplitude \'egale, mais direction oppos\'ee, \`a la mobilit\'e des ions chlorures. Cette narration vous entra\^ine ensuite vers les jours sombres v\'ecus lorsque nous avons \'et\'e dans l'impossibilit\'e d'\'etendre la port\'ee des s\'eparations isotopiques \`a des esp\`eces cationiques ou m\^eme d'expliquer pourquoi il n'y avait pas d'effet isotopique sur la mobilit\'e. Depuis ces jours sombres, nous avons fait de nombreuses d\'ecouvertes qui nous ont aid\'es dans notre qu\^ete. Premi\`erement, le d\'eveloppement des m\'ethodes impliquant le recouvrement des surfaces avec des agents de surface mixtes a permis de contr\^oler l'\'ecoulement \'electroosmotique invers\'e. Ce contr\^ole nous a permis d'effectuer des s\'eparations isotopiques de syst\`emes telles que les 15 N-14 N-anilines et 15 NH 4 +},
  keywords = {capillary zone electrophoresis,electroosmotic flow,ionic strength,isotopic,mobility modeling}
}

