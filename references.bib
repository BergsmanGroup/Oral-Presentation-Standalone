@article{Zhang2016,
  title = {Direct Assessment of Solid-Liquid Interface Noise in Ion Sensing Using a Differential Method},
  author = {Zhang, Da and Must, Indrek and Netzer, Nathan L. and Xu, Xingxing and Solomon, Paul and Zhang, Shi Li and Zhang, Zhen},
