@misc{gonzalez2026,
  title = {Vapor {{Phase Infiltration Towards}} the {{In Situ Growth}} of {{ZIF-8 Within Polymers}}},
  author = {Gonzalez, Seancarlos and Osburn, Cecilia and Graham, Daniel J. and Scott, Joelle V. and Biswal, Agni and Choe, Yuri and Bergsman, David S.},
  year = 2026,
  month = may,
  doi = {10.26434/chemrxiv.15003425/v1},
  urldate = {2026-08-05},
  abstract = {Vapor phase infiltration (VPI) of metal-organic reactants has emerged as a technique for postsynthetically introducing metal oxides into polymers, forming composite hybrid organic-inorganic materials. VPI of organic molecules, though seldom explored, could serve as a means for introducing other materials into polymers, such as metal-organic frameworks (MOFs), which could be used in the solvent-free synthesis of mixed matrix membranes (MMMs). In this work, we aim to demonstrate successful VPI of ZIF-8 into acrylonitrile butadiene styrene (ABS), as a demonstration of MOF infiltration into polymers. After exposing ABS to zinc oxide VPI and vapor exposure to 2-methylimidazole (2-HmIM), the characteristic peaks for ZIF-8 were observed via XRD. To confirm reactant infiltration, ToF-SIMS depth profiling was used to detect ions corresponding to zinc, 2-HmIM, and their reaction product. To eliminate contributions from ZIF-8 crystals formed on the polymer surface, infiltrated polymers were etched in water to remove surface ZIF-8. XRD measurements show that crystalline ZIF-8 is still present after etching with water suggesting that ZIF-8 crystals are present within the subsurface of the polymer. This work provides a proof-of-concept for MOF infiltration and growth using only vapor-phase methods.},
  langid = {english}
}

