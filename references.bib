@article{Larkin2013,
  title = {Slow {{DNA}} Transport through Nanopores in Hafnium Oxide Membranes},
  author = {Larkin, Joseph and Henley, Robert and Bell, David C. and {Cohen-Karni}, Tzahi and Rosenstein, Jacob K. and Wanunu, Meni},
